# ---------------------------------------------------------------------------
# Copy to .env.local for local development. See docs/ENVIRONMENT.md.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase (local values are printed by `npx supabase start`)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. NEVER expose to the browser or prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Shared secret for /api/cron/* (Supabase pg_cron / Vercel Cron call these)
CRON_SECRET=

# Email: "resend" (requires RESEND_API_KEY) or "console" (logs emails locally)
EMAIL_PROVIDER=console
RESEND_API_KEY=
EMAIL_FROM="Bismillah <hello@yourdomain.com>"

# Salt for hashing visitor IPs used by rate limiting (any random string)
RATE_LIMIT_SALT=

# Branding overrides (optional — defaults live in src/config/site.ts)
# NEXT_PUBLIC_AGENCY_NAME=Bismillah
# NEXT_PUBLIC_AGENCY_TAGLINE=
# NEXT_PUBLIC_BRAND_COLOR=oklch(0.46 0.085 165)
# NEXT_PUBLIC_CONTACT_EMAIL=
# NEXT_PUBLIC_CONTACT_PHONE=
# NEXT_PUBLIC_BOOKING_URL=
# NEXT_PUBLIC_DEFAULT_CURRENCY=USD
